HOST=127.0.0.1
PORT=7879
KIDSSCREEN_DATA_DIR=.data
# Public deployment: set NODE_ENV=production, HOST=0.0.0.0 and a persistent data volume.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KIDSSCREEN_ENCRYPTION_KEY=<32-byte base64 secret; back this up separately>

# Vercel / shared storage (server secrets, never VITE_ / NEXT_PUBLIC_):
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<read-write REST token>
# KIDSSCREEN_ENCRYPTION_KEY=<same persistent 32-byte base64 encryption key>

# Vercel integration aliases KV_REST_API_URL and KV_REST_API_TOKEN are also accepted.
